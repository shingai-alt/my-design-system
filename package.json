{
  "name": "my-design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ds-mcp": "src/mcp/server.mjs"
  },
  "scripts": {
    "build": "vite build && npm run build:icons && npm run build:foundations",
    "build:icons": "node scripts/build-icons.mjs",
    "build:foundations": "node scripts/build-color-page.mjs && node scripts/build-typography-page.mjs && node scripts/build-spacing-page.mjs && node scripts/build-effects-page.mjs",
    "mcp": "node src/mcp/server.mjs",
    "eval": "node evals/run.mjs",
    "eval:report": "node evals/report.mjs",
    "eval:report:html": "node evals/report-html.mjs",
    "check:consistency": "node scripts/check-consistency.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "lucide-static": "^1.47.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.0"
  }
}
